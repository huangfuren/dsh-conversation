{
  "name": "dsh-conversation",
  "version": "1.3.1",
  "description": "Conversation outline panel for the DSH web surface: user questions (index, time, per-turn stats) as level-0 nodes with the assistant reply's Markdown headings hanging beneath them — level slider, search scope, bookmarks, copy/export, section jump, keyboard nav and reading-position memory. Read-only UI: it never touches prompts, messages, tool results or provider traffic, and it writes nothing outside its own localStorage keys.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test",
    "verify": "npm run check && npm test",
    "prepack": "npm run verify"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.1.5-rc.2 <1.0.0"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "conversation",
    "outline",
    "navigation",
    "minimap",
    "ui"
  ],
  "author": "huangfuren",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangfuren/dsh-conversation.git"
  },
  "homepage": "https://github.com/huangfuren/dsh-conversation#readme",
  "bugs": {
    "url": "https://github.com/huangfuren/dsh-conversation/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
